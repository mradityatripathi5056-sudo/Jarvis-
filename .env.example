OPENROUTER_API_KEY=yaha_apni_openrouter_key_paste_karo
OPENROUTER_MODEL=minimax/minimax-m3:free
REASONING_ENABLED=false
REASONING_EFFORT=high
PHONE_PIN=2580
TTS_VOICE=hi-IN-MadhurNeural

# Agar wake word ("Jarvis") kaam na kare, galat microphone use ho sakta hai.
# Sahi index dhoondne ke liye chalao:
#   python -c "from speech import list_microphones; list_microphones()"
# phir yahan wo number daalo:
MIC_DEVICE_INDEX=

# Telegram messaging (optional) - BotFather se bot banao, @userinfobot se
# apni chat_id lo, phir yahan daalo:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_CONTACTS_FILE=telegram_contacts.json   (optional, default yahi hai)
# Multiple logon ko naam se msg karna ho to: sabko ek baar bot ko /start
# karwao, jarvis khud unka naam+chat_id save kar lega (har 30 sec check karta hai).
# Fir bolo: "Rohit ko bhejo ki..." ya "sabko bhejo ki... Raj ko chhodkar"

# Telegram se laptop CONTROL karna ho (jo command bhejo wahi laptop pe apply
# ho) to `python telegram_command_listener.py` chalao. Security ke liye sirf
# TELEGRAM_CHAT_ID (upar wala) se aaya command hi execute hota hai. Aur bhi
# trusted chat ids allow karne hain to comma se separate karke daalo:
# TELEGRAM_ALLOWED_CHAT_IDS=id1,id2

# Email (send_email action, optional) - Gmail App Password use karo
# (normal Gmail password kaam nahi karega): Google Account -> Security ->
# 2-Step Verification -> App passwords
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# ============================================================
# ADVANCED SKILLS (skills/ folder) - jo use karne hain sirf unke
# hi keys fill karo, baaki khaali chhodo (README mein har ek ka
# poora setup guide hai). Google Gmail/Calendar/Drive ko key nahi,
# google_credentials.json file chahiye (README dekho).
# ============================================================

# Outlook / Microsoft Graph (email, calendar, OneDrive)
MS_CLIENT_ID=

# Dropbox
DROPBOX_ACCESS_TOKEN=

# Smart Home (Home Assistant - recommended universal hub)
HA_URL=
HA_TOKEN=
# Smart Home (seedha Philips Hue, Home Assistant ke bina)
HUE_BRIDGE_IP=
HUE_USERNAME=

# Vision - "screen pe dekho aur batao" jaise commands ke liye ek
# VISION-CAPABLE model chahiye (text-only model se nahi chalega).
# YE ALAG setting hai OPENROUTER_MODEL se - aapka normal model (MiniMax
# ya jo bhi upar set hai) waisa hi chalega, ye sirf vision commands ke
# liye use hota hai. Khaali chhodoge to OPENROUTER_MODEL hi try hoga.
#
# NOTE: Gemini free tier OpenRouter pe ab available nahi hai (paid ho
# gaya hai) - isliye FREE vision model use kiya hai:
VISION_MODEL=google/gemma-4-31b-it:free

# Image GENERATION (banana, samajhna nahi) ke free models bahut kam
# milte hain OpenRouter pe - khaali chhod do agar free rehna hai,
# 'generate_image' action tab bas ek clear error dega (crash nahi hoga).
IMAGE_MODEL=

# Screen se text/code exact nikalne (OCR) ke liye - pip install pytesseract
# ke alawa Tesseract-OCR ka actual program bhi install karna hoga:
# https://github.com/UB-Mannheim/tesseract/wiki (Windows installer)
# Install ke baad yaha uska poora path daal do (default installer isi
# path pe daalta hai, bas confirm kar lena):
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Offline Mode Fallback (local LLM jab internet/OpenRouter na chale) -
# pehle Ollama install karo (https://ollama.com), phir "ollama pull llama3.2"
# chalao. Kuch na bharo to defaults use ho jaayenge.
OFFLINE_LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# GitHub
GITHUB_TOKEN=

# Jira
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# MySQL
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# MongoDB
MONGO_URI=
